{
  "name": "vr-geonusa-student-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VR-GeoNusa Student Frontend V1 — Borobudur panorama/WebXR learning experience. Consumes Laravel API (/api/v1); never calls ML service directly.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
