# VR-GeoNusa Student Frontend — environment config
# Salin jadi .env.local dan sesuaikan. JANGAN commit .env.local / .env.

# "mock"  -> pakai mock API in-memory (lihat src/api/mock), tidak butuh backend sama sekali.
#            Default ini supaya frontend bisa dikembangkan tanpa menunggu backend (lihat PRD #53).
# "real"  -> fetch sungguhan ke VITE_API_BASE_URL, ikuti contracts/openapi.yaml.
VITE_API_MODE=mock

# Dipakai hanya saat VITE_API_MODE=real. Base path API tetap /api/v1 (lihat PRD #9).
VITE_API_BASE_URL=http://localhost:8000
