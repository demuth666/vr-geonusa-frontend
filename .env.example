# VR-GeoNusa Student Frontend - environment config
# Salin jadi .env.local dan sesuaikan. JANGAN commit .env.local / .env.

# "mock"  -> pakai mock API in-memory (lihat src/api/mock), tidak butuh backend sama sekali.
# "real"  -> fetch sungguhan ke backend Laravel; ikuti contracts/openapi.yaml resmi.
#           Untuk integrasi, ubah ke "real" dan jalankan backend.
VITE_API_MODE=mock

# Kosongkan untuk memakai Vite dev proxy (/api/v1 -> http://localhost:8000).
# Isi dengan URL absolut (mis. https://api.contoh.id) bila tidak memakai proxy.
VITE_API_BASE_URL=

# Backend resmi memakai Sanctum Bearer token (OpenAPI bearerAuth).
# Token login disimpan di sessionStorage oleh src/api/auth-token.ts.
